// 由 .github/workflows/deploy-rules.yml 在規則檔變動時自動部署到 named database 'barthon'
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 只有這個管理員帳號能寫入
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'fg3797@gmail.com';
    }

    // 腕錶與網站文案：公開讀取,僅管理員可寫入
    match /watches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 瀏覽統計:訪客可累加計數(create/update),僅管理員可讀。
    // 欄位限定、值為數字/map;update 時 views/visitors 只能遞增,避免被惡意歸零或竄改。
    function statsFieldsOk() {
      return request.resource.data.keys().hasOnly(['date','views','visitors','clicks','updated'])
             && (!('views' in request.resource.data)    || request.resource.data.views is number)
             && (!('visitors' in request.resource.data) || request.resource.data.visitors is number)
             && (!('clicks' in request.resource.data)   || request.resource.data.clicks is map);
    }
    match /stats/{day} {
      allow read: if isAdmin();
      allow create: if statsFieldsOk();
      allow update: if statsFieldsOk()
                    && (!('views' in request.resource.data)    || request.resource.data.views >= resource.data.get('views', 0))
                    && (!('visitors' in request.resource.data) || request.resource.data.visitors >= resource.data.get('visitors', 0));
      // delete 未開放 → 一律拒絕
    }

    // 詢問單：訪客可送出(create),僅管理員可讀取/更新/刪除
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','contact','watch','message','date','status'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.contact is string
                    && request.resource.data.contact.size() > 0
                    && request.resource.data.contact.size() < 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 2000
                    && request.resource.data.watch is string
                    && request.resource.data.watch.size() < 200
                    && request.resource.data.date is string
                    && request.resource.data.status == '新';
      allow read, update, delete: if isAdmin();
    }

    // 流量分析事件：訪客可建立(create only,不可讀取別人的),管理員可讀取所有
    // 欄位驗證:type 限定值、timestamp 必須是近期時間、visitorId 必填
    function analyticsEventValid() {
      let data = request.resource.data;
      return data.keys().hasOnly(['type','visitorId','sessionId','timestamp','path','referrer','watchId','watchBrand','watchModel','userAgent','screen'])
             && data.type in ['page_view', 'product_view', 'product_click']
             && data.visitorId is string && data.visitorId.size() > 0 && data.visitorId.size() < 100
             && data.timestamp is timestamp
             && (request.time - data.timestamp < duration.value(120, 's'))  // 事件不能比現在早超過 2 分鐘
             && (!('path' in data) || (data.path is string && data.path.size() < 300))
             && (!('watchId' in data) || (data.watchId is string && data.watchId.size() < 100));
    }
    match /analytics_events/{id} {
      allow create: if analyticsEventValid();
      allow read, delete: if isAdmin();
      allow update: if false;  // 事件一旦建立不可修改
    }

    // 流量分析每日彙總：只有管理員(或 Cloud Function 的 Admin SDK)能讀寫
    match /analytics_daily/{day} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 系統設定(如 config/line 的 LINE 接收者名單):
    // 只有雲端函式(Admin SDK,會略過規則)能存取;前端一律禁止讀寫。
    match /config/{doc} {
      allow read, write: if false;
    }
  }
}
